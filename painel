// ── SUPERVISOR LOCK ────────────────────────────────────────
function isSupervisorUnlocked(){
  try{ return sessionStorage.getItem(SUP_SESSAO_KEY)==='1'; }catch(e){ return false; }
}
function requestSupervisorAccess(aba, btn){
  if(isSupervisorUnlocked()){
