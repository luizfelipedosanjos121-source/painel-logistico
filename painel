// ── APROVAÇÕES — RELATÓRIO ────────────────────────────────
function aprovBuildReport(){
  const ini=document.getElementById('af-rel-ini').value;
  const fim=document.getElementById('af-rel-fim').value;
  const conf=document.getElementById('af-rel-conf').value;
  const st=document.getElementById('af-rel-status').value;

  const recs=aprovRecords.filter(r=>{
    if(!r.data) return false;
    if(ini&&r.data<ini) return false;
    if(fim&&r.data>fim) return false;
    if(conf&&r.conferente!==conf) return false;
    if(st&&r.status!==st) return false;
    return true;
  });

  const fmtD=d=>d?new Date(d+'T00:00:00').toLocaleDateString('pt-BR'):'?';
  const per=ini===fim?fmtD(ini):`${fmtD(ini)} a ${fmtD(fim)}`;

  const porConf={};
  let tDesc=0,tCarga=0,somaMin=0,comTempo=0;
  recs.forEach(r=>{
    const c=r.conferente||'Sem Conferente';
    if(!porConf[c]) porConf[c]={desc:0,carga:0,sep:0,sepOp:0,recOp:0,somaMin:0,comTempo:0,aprov:0,pend:0,repro:0};
    const ti=r.tipo;
    if(ti==='DESCARGA')        { porConf[c].desc++; tDesc++; }
    else if(ti==='CARREGAMENTO'){ porConf[c].carga++; tCarga++; }
    else if(ti==='SEPARAÇÃO')   porConf[c].sep++;
    else if(ti==='SEPARAÇÃO OP')porConf[c].sepOp++;
    else if(ti==='RECEBIMENTO OP')porConf[c].recOp++;
    if(r.status==='APROVADO') porConf[c].aprov++;
    else if(r.status==='PENDENTE') porConf[c].pend++;
    else porConf[c].repro++;
    const m=parseMin(r.data,r.horainicial,r.horafinal);
    if(m!==null){ porConf[c].somaMin+=m; porConf[c].comTempo++; somaMin+=m; comTempo++; }
  });

  let txt=`╔══════════════════════════════════════╗\n`;
  txt+=`║   ICC — RELATÓRIO LOGÍSTICO          ║\n`;
  txt+=`╚══════════════════════════════════════╝\n`;
  txt+=`Período : ${per}\n`;
  txt+=`Filtro  : ${st||'Todos os status'}${conf?' | Conf: '+conf:''}\n`;
  txt+=`Gerado  : ${new Date().toLocaleString('pt-BR')}\n`;
  txt+=`\n── RESUMO GERAL ───────────────────────\n`;
  txt+=`Total de operações : ${recs.length}\n`;
  txt+=`Descargas          : ${tDesc}\n`;
  txt+=`Carregamentos      : ${tCarga}\n`;
  txt+=`Tempo médio geral  : ${comTempo?Math.round(somaMin/comTempo)+' min':'--'}\n`;
  const confs=Object.keys(porConf).sort();
  if(confs.length){
    txt+=`\n── POR CONFERENTE ─────────────────────\n`;
    confs.forEach(c=>{
      const p=porConf[c];
      const media=p.comTempo?Math.round(p.somaMin/p.comTempo)+' min':'--';
      txt+=`\n▸ ${c}\n`;
      txt+=`  Descargas    : ${p.desc}\n`;
      txt+=`  Carregamentos: ${p.carga}\n`;
      if(p.sep)   txt+=`  Separação    : ${p.sep}\n`;
      if(p.sepOp) txt+=`  Separação OP : ${p.sepOp}\n`;
      if(p.recOp) txt+=`  Recebimento  : ${p.recOp}\n`;
      txt+=`  Tempo médio  : ${media}\n`;
      txt+=`  ✅ ${p.aprov} | ⏳ ${p.pend} | ❌ ${p.repro}\n`;
    });
  }
  txt+=`\n═══════════════════════════════════════\n`;
  document.getElementById('aprov-rel-txt').value=txt;
}

