  document.getElementById('sup-lock-err').textContent='';
  document.getElementById('sup-lock-input').value='';
  document.getElementById('sup-lock-bg').style.display='flex';
  document.getElementById('sup-lock-input').focus();
}
function trySupUnlock(){
  const v = document.getElementById('sup-lock-input').value;
  if(v === SENHA_SUPERVISOR){
    try{ sessionStorage.setItem(SUP_SESSAO_KEY,'1'); }catch(e){}
