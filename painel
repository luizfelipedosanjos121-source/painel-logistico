<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ICC - Sistema de Logística Integrado</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
  <style>
    :root {
      --bg-body:    #10141a;
      --bg-panel:   #171d26;
      --bg-panel-2: #1c232e;
      --border-soft:#2a3240;
      --primary-red:#d9564b;
      --primary-blue:#4a90d9;
      --primary-green:#34c281;
      --nav-bg:     #171d26;
      --text-gold:  #d4af37;
      --text-gold-s:#e0c46a;
      --text-main:  #e9edf2;
      --text-dim:   #8894a3;
      --input-bg:   #0d1117;
      --radius:     8px;
    }
    *{box-sizing:border-box;margin:0;padding:0;font-family:'Segoe UI',system-ui,Roboto,sans-serif}
    html{color-scheme:dark}
    body{background:var(--bg-body);color:var(--text-main);display:flex;flex-direction:column;align-items:center;min-height:100vh}

    /* ── HEADER ── */
    header{width:100%;background:#fff;padding:22px 0 16px;text-align:center;box-shadow:0 2px 20px rgba(0,0,0,.5);position:relative}
    header::after{content:'';position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,var(--primary-green),var(--text-gold))}
    .logo-area img{width:150px;display:block;margin:0 auto}
    .logo-area .tagline{font-size:10.5px;color:#7a7a7a;text-transform:uppercase;letter-spacing:2px;margin-top:2px;font-weight:500}
    .live-badge{display:inline-flex;align-items:center;gap:6px;font-size:10.5px;font-weight:700;color:var(--primary-green);text-transform:uppercase;margin-top:10px;letter-spacing:1px;background:rgba(52,194,129,.08);padding:4px 12px;border-radius:20px}
    .live-dot{width:8px;height:8px;border-radius:50%;background:var(--primary-green);box-shadow:0 0 6px var(--primary-green);animation:pulse 1.6s infinite}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}

    /* ── NAV ── */
    nav{width:100%;background:var(--nav-bg);display:flex;justify-content:center;gap:4px;padding:8px 10px;overflow-x:auto;border-bottom:1px solid var(--border-soft)}
    nav button{background:transparent;border:1px solid transparent;color:var(--text-dim);padding:10px 16px;cursor:pointer;font-size:11.5px;font-weight:700;text-transform:uppercase;transition:.2s;white-space:nowrap;border-radius:6px;letter-spacing:.5px}
    nav button:hover{color:var(--text-main);background:rgba(255,255,255,.05)}
    nav button.active{color:#14181f;background:var(--text-gold);border-color:var(--text-gold)}
    nav button.locked-nav::after{content:' 🔒';font-size:9px}

    /* ── MAIN ── */
    main{width:100%;max-width:1000px;margin:30px 10px;padding:0 4px}
    .sub-title{color:var(--text-gold);font-size:13px;font-weight:700;letter-spacing:1px;margin-bottom:5px}
    h2{font-size:26px;text-transform:uppercase;margin-bottom:5px;color:#fff;letter-spacing:.5px}
    .description{color:var(--text-dim);font-size:13px;margin-bottom:20px}

    .card{background:var(--bg-panel);border:1px solid var(--border-soft);border-left:3px solid var(--text-gold);border-radius:var(--radius);padding:25px;box-shadow:0 10px 30px rgba(0,0,0,.4)}
    .card-section-title{font-size:11px;font-weight:700;color:var(--text-gold-s);margin-bottom:15px;display:flex;align-items:center;gap:6px;text-transform:uppercase;letter-spacing:.5px}

    /* ── TORRE ── */
    .torre-box{background:var(--bg-panel-2);border:1px solid var(--primary-blue);border-radius:var(--radius);padding:15px;margin-bottom:20px;grid-column:span 2}
    .torre-box label{color:var(--primary-blue);font-size:12px;font-weight:700;display:block;margin-bottom:8px;letter-spacing:.5px}
    .reserva-info{font-size:11px;color:var(--primary-green);margin-top:8px;display:none}
    .reserva-info.show{display:block}

    /* ── AUTO PREVIEW (dados puxados automaticamente da torre) ── */
    .auto-preview{grid-column:span 2;background:var(--bg-panel-2);border:1px dashed var(--border-soft);border-radius:var(--radius);padding:14px 16px;margin-bottom:6px;display:none}
    .auto-preview.show{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px}
    .auto-preview .ap-item{display:flex;flex-direction:column;gap:2px}
    .auto-preview .ap-lbl{font-size:9.5px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.5px;font-weight:700}
    .auto-preview .ap-val{font-size:13px;color:var(--text-gold-s);font-weight:600}
    .auto-preview .ap-val.empty{color:var(--text-dim);font-weight:400;font-style:italic}
    .auto-preview-title{grid-column:1/-1;font-size:10.5px;font-weight:700;color:var(--primary-blue);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;display:flex;align-items:center;gap:6px}

    /* ── FORM ── */
    .form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}
    .full-width{grid-column:span 2}
    .kpi-grid{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))!important}
    .field-group{display:flex;flex-direction:column;gap:5px}
    label{font-size:11px;font-weight:700;color:var(--text-dim);text-transform:uppercase;letter-spacing:.4px}
    input,select{padding:10px;border:1px solid var(--border-soft);border-radius:5px;font-size:14px;background:var(--input-bg);color:var(--text-main);width:100%}
    input:focus,select:focus{outline:none;border-color:var(--text-gold)}
    select option{background:var(--input-bg);color:var(--text-main)}
    .field-required label::after{content:' *';color:var(--primary-red)}

    /* ── KPI CARDS ── */
    .kpi-card{background:#fff;border:1px solid #ddd;border-left:4px solid var(--primary-red);border-radius:var(--radius);padding:20px 15px;text-align:center;box-shadow:0 2px 10px rgba(0,0,0,.25)}
    .kpi-icon{font-size:20px;margin-bottom:8px}
    .kpi-value{font-size:30px;font-weight:700;color:var(--primary-red);line-height:1}
    .kpi-label{font-size:11px;color:#666;text-transform:uppercase;margin-top:8px;letter-spacing:.5px}
    .kpi-aviso{grid-column:1/-1;color:var(--primary-red);font-weight:700;font-size:13px;text-align:center;padding:10px}
    .kpi-note{grid-column:1/-1;background:var(--bg-panel-2);border:1px solid var(--text-gold);color:var(--text-gold-s);font-size:11.5px;padding:10px 14px;border-radius:6px;margin-bottom:4px}
    .kpi-chart-wrap{grid-column:1/-1;background:#fff;border:1px solid #ddd;border-radius:var(--radius);padding:20px;margin-top:20px;height:340px}
    .kpi-chart-wrap canvas{max-height:270px}

    /* ── RESUMO BOX ── */
    .kpi-resumo-box{grid-column:1/-1;background:var(--bg-panel-2);border:1px solid var(--primary-green);border-radius:var(--radius);padding:18px;margin-top:20px}
    .kpi-resumo-box label{color:var(--primary-green);font-size:12px;font-weight:700;display:block;margin-bottom:10px;letter-spacing:.5px}
    .kpi-resumo-box textarea{width:100%;min-height:140px;background:var(--input-bg);color:var(--text-main);border:1px solid var(--border-soft);border-radius:6px;padding:10px;font-size:12px;font-family:'Courier New',monospace;resize:vertical;margin-bottom:10px}
    .resumo-periodo-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
    .resumo-status{font-size:11px;color:var(--text-dim);margin-top:8px}
    .btn-row{display:flex;gap:10px;flex-wrap:wrap}
    .btn-wpp{background:var(--primary-green);color:#06231a;border:none;padding:12px 18px;border-radius:6px;font-weight:700;font-size:13px;cursor:pointer;text-transform:uppercase;letter-spacing:.4px;transition:.2s}
    .btn-wpp:hover{filter:brightness(1.1)}
    .btn-wpp.alt{background:var(--text-gold);color:#2a2205}

    /* ── TIME BOX ── */
    .time-control-box{background:var(--bg-panel-2);border:1px solid var(--border-soft);border-radius:6px;padding:15px;margin-top:20px}
    .time-control-box.locked{border-color:var(--primary-green)}
    .time-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
    .btn-current-time{background:var(--primary-blue);color:#fff;border:none;padding:10px;border-radius:5px;cursor:pointer;font-size:12px;font-weight:700;transition:.2s;width:100%}
    .btn-current-time:hover{filter:brightness(1.1)}
    .btn-current-time:disabled{background:#3a4250;cursor:not-allowed}
    input[readonly]{background:#0a0d12;color:var(--primary-green);font-weight:700;cursor:not-allowed}

    /* ── SUBMIT ── */
    .btn-submit{width:100%;background:var(--primary-red);color:#fff;border:none;padding:15px;margin-top:25px;border-radius:6px;font-weight:700;font-size:16px;text-transform:uppercase;cursor:pointer;transition:.2s;letter-spacing:.5px}
    .btn-submit:hover{filter:brightness(1.1)}
    .btn-submit:disabled{background:#444;color:#888;cursor:not-allowed}
    .form-alert{grid-column:1/-1;background:rgba(217,86,75,.12);border:1px solid var(--primary-red);color:#f0a99e;font-size:12px;font-weight:600;padding:10px 14px;border-radius:6px;display:none}
    .form-alert.show{display:block}

    /* ── HISTORY ── */
    .history-card{background:var(--bg-panel);border:1px solid var(--border-soft);border-left:3px solid var(--text-gold);border-radius:var(--radius);margin-top:30px;padding:20px;overflow-x:auto}
    table{width:100%;border-collapse:collapse;margin-top:10px;font-size:11px}
    table th{background:#0d1117;color:var(--text-gold-s)!important;padding:10px;text-align:left;text-transform:uppercase;letter-spacing:.4px}
    table td{padding:10px;border-bottom:1px solid var(--border-soft);color:var(--text-main)!important;background:var(--bg-panel)}
    table tbody tr:nth-child(even) td{background:var(--bg-panel-2)}

    /* ── APROVAÇÕES INLINE ── */
    #aprovacoes-inline{display:none}
    .aprov-tabs{display:flex;gap:4px;margin-bottom:16px;border-bottom:2px solid var(--border-soft);padding-bottom:4px;flex-wrap:wrap}
    .aprov-tab{background:transparent;border:none;color:var(--text-dim);font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:8px 14px;cursor:pointer;border-radius:6px 6px 0 0;transition:.15s;border-bottom:2px solid transparent;margin-bottom:-2px}
    .aprov-tab:hover{color:var(--text-main);background:rgba(255,255,255,.04)}
    .aprov-tab.active{color:var(--text-gold);border-bottom-color:var(--text-gold)}

    .aprov-card{background:var(--bg-panel-2);border:1px solid var(--border-soft);border-left:3px solid var(--text-gold);border-radius:var(--radius);padding:18px;margin-bottom:16px}
    .aprov-card h3{font-size:10px;font-weight:700;color:var(--text-gold-s);text-transform:uppercase;letter-spacing:.12em;margin-bottom:14px}

    .aprov-filter-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;align-items:flex-end}
    .aprov-field{display:flex;flex-direction:column;gap:4px}
    .aprov-field label{font-size:10px;font-weight:700;color:var(--text-dim);text-transform:uppercase;letter-spacing:.06em}
    .aprov-field select,.aprov-field input{padding:8px 10px;border:1px solid var(--border-soft);border-radius:5px;background:var(--input-bg);color:var(--text-main);font-size:12px;min-width:130px}
    .aprov-field select:focus,.aprov-field input:focus{outline:2px solid var(--text-gold);border-color:var(--text-gold)}

    .aprov-kpi-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px}
    .aprov-kpi{background:var(--bg-panel);border:1px solid var(--border-soft);border-radius:var(--radius);padding:14px;text-align:center}
    .aprov-kpi-val{font-size:26px;font-weight:700;line-height:1}
    .aprov-kpi-lbl{font-size:10px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.05em;margin-top:5px}
    .aprov-kpi.gold .aprov-kpi-val{color:var(--text-gold)}
    .aprov-kpi.green .aprov-kpi-val{color:var(--primary-green)}
    .aprov-kpi.red .aprov-kpi-val{color:var(--primary-red)}
    .aprov-kpi.blue .aprov-kpi-val{color:var(--primary-blue)}

    .aprov-btn{border:none;border-radius:5px;font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.07em;padding:8px 12px;cursor:pointer;transition:.15s}
    .aprov-btn:hover{filter:brightness(1.1)}
    .aprov-btn.gold{background:var(--text-gold);color:#111}
    .aprov-btn.green{background:var(--primary-green);color:#06231a}
    .aprov-btn.red{background:var(--primary-red);color:#fff}
    .aprov-btn.blue{background:var(--primary-blue);color:#fff}
    .aprov-btn.ghost{background:transparent;border:1px solid var(--border-soft);color:var(--text-dim)}
    .aprov-btn.ghost:hover{color:var(--text-main);border-color:var(--text-dim)}

    .aprov-badge{display:inline-block;padding:3px 8px;border-radius:4px;font-size:10px;font-weight:700;text-transform:uppercase}
    .ab-pend{background:rgba(212,175,55,.2);color:var(--text-gold)}
    .ab-ok{background:rgba(52,194,129,.2);color:var(--primary-green)}
    .ab-no{background:rgba(217,86,75,.2);color:var(--primary-red)}
    .ab-carga{background:rgba(217,86,75,.15);color:#f0806e}
    .ab-sep{background:rgba(74,144,217,.15);color:#7ab8f0}

    .aprov-table-wrap{overflow-x:auto}
    .aprov-table{width:100%;border-collapse:collapse;font-size:11.5px}
    .aprov-table th{background:#0d1117;color:var(--text-gold-s);padding:9px 8px;text-align:left;text-transform:uppercase;font-size:10px;letter-spacing:.05em;font-weight:700}
    .aprov-table td{padding:8px;border-bottom:1px solid var(--border-soft);color:var(--text-main)}
    .aprov-table tbody tr:nth-child(even) td{background:#141b24}
    .aprov-table tbody tr:hover td{background:rgba(212,175,55,.04)}

    .aprov-empty{text-align:center;padding:20px;color:var(--text-dim);font-size:12px}
    .aprov-spin{display:inline-block;width:11px;height:11px;border-radius:50%;border:2px solid var(--border-soft);border-top-color:var(--text-gold);animation:spin .7s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .aprov-status{font-size:11px;color:var(--text-dim);display:flex;align-items:center;gap:6px;min-height:16px;margin-top:8px}

    /* ── REPORT BOX ── */
    .rel-box{background:var(--bg-panel-2);border:1px solid var(--border-soft);border-left:3px solid var(--primary-green);border-radius:var(--radius);padding:18px;margin-top:16px}
    .rel-box h3{font-size:10px;font-weight:700;color:var(--primary-green);text-transform:uppercase;letter-spacing:.12em;margin-bottom:14px}
    .rel-box textarea{width:100%;min-height:200px;background:var(--input-bg);color:var(--text-main);border:1px solid var(--border-soft);border-radius:6px;padding:10px;font-family:'Courier New',monospace;font-size:11.5px;resize:vertical;margin-bottom:10px}
    .rel-box textarea:focus{outline:2px solid var(--text-gold)}

    /* ── MODAL ── */
    .aprov-modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;z-index:9999}
    .aprov-modal{background:var(--bg-panel);border:1px solid var(--border-soft);border-radius:var(--radius);padding:24px;max-width:480px;width:90%;box-shadow:0 16px 40px rgba(0,0,0,.5)}
    .aprov-modal-title{font-size:15px;font-weight:700;color:var(--text-gold);margin-bottom:16px}
    .aprov-modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:6px}
    .aprov-mf label{font-size:10px;font-weight:700;color:var(--text-dim);text-transform:uppercase;letter-spacing:.06em;display:block;margin-bottom:2px}
    .aprov-mf .val{font-size:13px;font-weight:600;color:var(--text-main)}
    .aprov-modal-actions{display:flex;gap:10px;margin-top:18px}
    .aprov-modal-actions .aprov-btn{flex:1;padding:11px}

    /* ── OVERLAY ── */
    #loading-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.85);display:none;justify-content:center;align-items:center;color:var(--text-gold);font-weight:700;z-index:9999}

    /* ── SUPERVISOR LOCK (área protegida por senha: KPI / Aprovações) ── */
    #sup-lock-bg{position:fixed;inset:0;background:rgba(0,0,0,.7);display:none;align-items:center;justify-content:center;z-index:10000}
    #sup-lock{max-width:380px;width:90%;background:var(--bg-panel);border:1px solid var(--border-soft);border-top:3px solid var(--text-gold);border-radius:var(--radius);padding:34px 28px;text-align:center;box-shadow:0 16px 40px rgba(0,0,0,.5)}
    #sup-lock .icon{font-size:36px;margin-bottom:10px}
    #sup-lock h2{font-size:17px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px;color:#fff}
    #sup-lock p{color:var(--text-dim);font-size:12px;margin-bottom:20px}
    #sup-lock input{width:100%;font-size:18px;text-align:center;letter-spacing:.4em;padding:11px;border:1px solid var(--border-soft);border-radius:6px;background:var(--input-bg);color:var(--text-main);margin-bottom:12px}
    #sup-lock input:focus{outline:2px solid var(--text-gold);border-color:var(--text-gold)}
    #sup-lock .aprov-btn{width:100%;padding:12px}
    #sup-lock-err{color:#E8A798;font-size:12px;margin-top:10px;min-height:16px}
    #sup-lock .cancel-link{display:block;margin-top:14px;color:var(--text-dim);font-size:11px;cursor:pointer;text-decoration:underline}

    @media(max-width:900px){main{max-width:100%;padding:0 4px}}
    @media(max-width:600px){
      .form-grid,.time-grid,.resumo-periodo-grid,.aprov-filter-row{grid-template-columns:1fr}
      .full-width,.torre-box,.auto-preview{grid-column:span 1}
      h2{font-size:21px}
      nav{justify-content:flex-start}
      .kpi-value{font-size:24px}
      .aprov-kpi-row{grid-template-columns:repeat(2,1fr)}
      .aprov-modal-grid{grid-template-columns:1fr}
    }
  </style>
</head>
<body>

<div id="loading-overlay">Processando... Aguarde.</div>

<!-- LOCK DE ÁREA SUPERVISOR (protege KPI e APROVAÇÕES) -->
<div id="sup-lock-bg">
  <div id="sup-lock">
    <div class="icon">🔐</div>
    <h2>Área do Supervisor</h2>
    <p>Somente gestores autorizados. Digite a senha para continuar.</p>
    <input type="password" id="sup-lock-input" placeholder="••••" maxlength="12" inputmode="numeric">
    <button class="aprov-btn gold" onclick="trySupUnlock()">Entrar</button>
    <div id="sup-lock-err"></div>
    <span class="cancel-link" onclick="cancelSupLock()">Cancelar</span>
  </div>
</div>

<header>
  <div class="logo-area">
    <img alt="ICC" src="https://blogger.googleusercontent.com/img/a/AVvXsEh9o7gVmVyhlIUhaO_N9UPrs3m4XZW9SDmy-fi8sELhnsk0BWuzOHSBhnz2ExxTZhHtu5NKCSgknF24H3S_beVYS9X5phbqx4i0xWjiEDHgCM20IFY1w6IgER9-F0W9J48wzVxc_h0uq7JuwzC4lazzh4asYhjSnWq9ZLtE7OtI770Y5F3d0H8PlMyJDhGH">
    <div class="live-badge"><span class="live-dot"></span> AO VIVO • <span id="relogio">--:--:--</span></div>
  </div>
</header>

<nav id="main-nav">
  <button class="active" onclick="switchPage('CargaDescarga',this)">🚚 CARGA / DESCARGA</button>
  <button class="locked-nav" onclick="requestSupervisorAccess('KPI',this)">📊 KPI</button>
  <button class="locked-nav" onclick="requestSupervisorAccess('Aprovacoes',this)">✅ APROVAÇÕES</button>
  <button onclick="switchPage('Separacao',this)">📦 SEPARAÇÃO</button>
  <button onclick="switchPage('SeparacaoOP',this)">📦 SEPARAÇÃO OP</button>
  <button onclick="switchPage('RecebimentoOP',this)">📥 RECEBIMENTO OP</button>
  <button onclick="switchPage('CadastroConferentes',this)">👤 CONFERENTES</button>
  <button onclick="switchPage('CadastroOperadores',this)">👷 OPERADORES</button>
  <button id="sup-logout-btn" style="display:none;color:var(--primary-red)" onclick="doSupLogout()">🔒 Bloquear Supervisor</button>
</nav>

<main>
  <p class="sub-title">LOGÍSTICA • ICC</p>
  <h2 id="page-title">CARGA / DESCARGA</h2>
  <p class="description" id="page-desc">Preenchimento dos campos do processo.</p>

  <div class="card" id="main-card">
    <div class="card-section-title" id="process-section-title">✨ Campos do Processo</div>
    <form class="form-grid" id="main-form"></form>
  </div>

  <!-- APROVAÇÕES INLINE -->
  <div id="aprovacoes-inline">
    <div class="aprov-tabs">
      <button class="aprov-tab active" onclick="showAprovTab('aprov-tab-hoje',this)">📅 Operações de Hoje</button>
      <button class="aprov-tab" onclick="showAprovTab('aprov-tab-hist',this)">🗂️ Histórico</button>
      <button class="aprov-tab" onclick="showAprovTab('aprov-tab-rel',this)">📄 Relatório</button>
    </div>

    <!-- HOJE -->
    <div id="aprov-tab-hoje">
      <div class="aprov-kpi-row" id="aprov-kpi-hoje"></div>
      <div class="aprov-card">
        <h3>🔍 Filtros</h3>
        <div class="aprov-filter-row">
          <div class="aprov-field">
            <label>Processo</label>
            <select id="af-tipo">
              <option value="">Todos</option>
              <option>CARREGAMENTO</option><option>DESCARGA</option>
