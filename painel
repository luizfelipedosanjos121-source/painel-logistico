function aprovGetHoje(){
  const hoje=getTodayStr();
  const tipo=document.getElementById('af-tipo').value;
  const conf=document.getElementById('af-conf').value;
  const st=document.getElementById('af-status').value;
  return aprovRecords.filter(r=>{
    if(r.data!==hoje) return false;
    if(tipo&&r.tipo!==tipo) return false;
    if(conf&&r.conferente!==conf) return false;
    if(st&&r.status!==st) return false;
    return true;
  });
}
['af-tipo','af-conf','af-status'].forEach(id=>{
  document.addEventListener('DOMContentLoaded', function(){
    const el=document.getElementById(id);
    if(el) el.addEventListener('change',aprovRenderHoje);
