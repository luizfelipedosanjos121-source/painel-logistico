// ── RESUMO WA ────────────────────────────────────────────
function montarResumoTextoPeriodo(ini,fim){
  const todos=(masterData&&masterData.CargaDescarga)||[];
  const gv=(obj,key)=>{ if(obj[key]!==undefined) return obj[key]; const f=Object.keys(obj).find(k=>k.toLowerCase()===key.toLowerCase()); return f?obj[f]:undefined; };
  const noPer=todos.filter(r=>{ const d=gv(r,'data'); return d&&d>=ini&&d<=fim; });
  const aprov=noPer.filter(r=>statusAprovacaoDoRegistro(r)==='APROVADO');
  const porConf={};
  let tDesc=0,tCarga=0,somaMin=0,comTempo=0;
  aprov.forEach(r=>{
    const c=(gv(r,'conferente')&&String(gv(r,'conferente')).trim())||'Sem Conferente';
    const tipo=String(gv(r,'tipo')||'').toLowerCase();
    if(!porConf[c]) porConf[c]={desc:0,carga:0,somaMin:0,comTempo:0};
    if(tipo.includes('descarga')){ porConf[c].desc++; tDesc++; }
    else if(tipo.includes('carga')){ porConf[c].carga++; tCarga++; }
    const data=gv(r,'data'),hi=gv(r,'horainicial'),hf=gv(r,'horafinal');
    if(data&&hi&&hf){ const dI=new Date(data+'T'+hi),dF=new Date(data+'T'+hf); let d=(dF-dI)/60000; if(!isNaN(d)){ if(d<0)d+=1440; if(d>=0&&d<1440){ porConf[c].somaMin+=d; porConf[c].comTempo++; somaMin+=d; comTempo++; } } }
  });
  const fmtD=d=>d?new Date(d+'T00:00:00').toLocaleDateString('pt-BR'):'?';
  const per=ini===fim?fmtD(ini):`${fmtD(ini)} a ${fmtD(fim)}`;
  let txt=`*ICC - Resumo (${per})*\n_Somente operações aprovadas_\n`;
  txt+=`Total: ${aprov.length} | Descargas: ${tDesc} | Cargas: ${tCarga}\n`;
  txt+=`Tempo médio geral: ${comTempo?Math.round(somaMin/comTempo)+'min':'--'}\n\n*Por conferente:*\n`;
  if(!Object.keys(porConf).length) txt+='- (nenhuma operação aprovada)\n';
  Object.keys(porConf).sort().forEach(c=>{ const p=porConf[c]; txt+=`- ${c}: ${p.desc} desc, ${p.carga} carga, média ${p.comTempo?Math.round(p.somaMin/p.comTempo):'--'}min\n`; });
  return txt;
}
function atualizarPreviewResumo(){
  const ini=document.getElementById('resumo-ini');
  const fim=document.getElementById('resumo-fim');
  const ta=document.getElementById('resumo-txt');
  if(ini&&fim&&ta) ta.value=montarResumoTextoPeriodo(ini.value,fim.value);
}
function enviarResumoWA(auto){
  let txt;
  if(auto){ const h=getTodayStr(); txt=montarResumoTextoPeriodo(h,h); }
  else { atualizarPreviewResumo(); txt=document.getElementById('resumo-txt')?document.getElementById('resumo-txt').value:''; }
  if(!txt) return;
  const url=`https://api.callmebot.com/whatsapp.php?phone=${WA_PHONE}&text=${encodeURIComponent(txt)}&apikey=${WA_APIKEY}`;
  fetch(url,{mode:'no-cors'}).then(()=>{ marcarResumoHoje(); const s=document.getElementById('resumo-status'); if(s)s.textContent='✅ Enviado!'; if(!auto)alert('Resumo enviado!'); }).catch(()=>{ if(!auto)alert('Erro ao enviar.'); });
}
function chaveResumoHoje(){ return 'icc_resumo_'+getTodayStr(); }
function resumoJaEnviadoHoje(){ return !!localStorage.getItem(chaveResumoHoje()); }
function marcarResumoHoje(){ try{ localStorage.setItem(chaveResumoHoje(),'1'); }catch(e){} }
function verificarResumoAutomatico(){
  if(resumoJaEnviadoHoje()) return;
  const agora=new Date();
  const [h,m]=RESUMO_HORA.split(':').map(Number);
  const alvo=new Date(agora); alvo.setHours(h,m,0,0);
  const diff=(agora-alvo)/60000;
  if(diff<0||diff>10) return;
  const recs=(masterData&&masterData.CargaDescarga)||[];
  if(!recs.length) return;
  enviarResumoWA(true);
}

// ── TORRE ────────────────────────────────────────────────
function dentroDoDiaOp(dateStr){
  if(!dateStr) return false;
  const d=new Date(dateStr);
  if(isNaN(d.getTime())) return false;
  const agora=new Date();
  const ini=new Date(agora); ini.setHours(6,0,0,0);
  if(agora<ini) ini.setDate(ini.getDate()-1);
  const fim=new Date(ini.getFullYear(),ini.getMonth(),ini.getDate()+1,0,0,0,0);
  return d>=ini&&d<fim;
}
function montarSelectTorre(){
  const select=document.getElementById('select_torre');
  if(!select||!torreData) return;
  const cur=select.value;
  limparReservasExpiradas(); salvarReservasLocais();
  select.innerHTML='<option value="">-- Escolha um caminhão --</option>';
  const fmt=c=>`${c.ordem?c.ordem+'ª ':''}`+`${(c.tipo||'').toUpperCase()}`+`${c.destino?' '+c.destino:''}`+`${c.romaneio?' '+c.romaneio:''}`+`${c.bags?' '+c.bags:''}`+`${c.veiculo?' ('+c.veiculo+')':''}`+`${c.motorista?' MOT '+c.motorista:''}`+`${c.transportadora?' ('+c.transportadora+')':''}`;
  if(torreData.concluidosRecentes){
    torreData.concluidosRecentes.forEach((c,idx)=>{
      const d=c.concluidoEm||c.desde;
      if(!dentroDoDiaOp(d)) return;
      const chave=`concluido::${idx}`;
      if(chaveReservadaPorOutro(chave)) return;
      const preso=reservasLocais[chave]?'🔒 ':(c.recusado?'🔴 ':'🔵 ');
      select.add(new Option(`${preso}${c.recusado?'RECUSADO':'FINALIZADO'} | ${fmt(c)}`,chave));
    });
  }
  if(cur&&select.querySelector(`option[value="${cur}"]`)) select.value=cur;
  const info=document.getElementById('reserva-info');
  if(info) info.classList.toggle('show',!!reservasLocais[select.value]);
  atualizarPreviewAuto();
}

function setPreviewCampo(id,valor){
  const el=document.getElementById(id);
  if(!el) return;
  if(valor){ el.textContent=valor; el.classList.remove('empty'); }
  else{ el.textContent='—'; el.classList.add('empty'); }
}

function atualizarPreviewAuto(){
  const c=camSelecionado||{};
  setPreviewCampo('ap_tipo', c.tipo || '');
  setPreviewCampo('ap_motorista', c.motorista || '');
  setPreviewCampo('ap_nf', c.nf || '');
  setPreviewCampo('ap_cliente', c.cliente || '');
  setPreviewCampo('ap_data', c.data ? new Date(c.data+'T00:00:00').toLocaleDateString('pt-BR') : '');
  setPreviewCampo('ap_horainicial', c.horainicial || '');
  setPreviewCampo('ap_horafinal', c.horafinal || '');
  const prev=document.getElementById('auto-preview');
  if(prev) prev.classList.toggle('show', !!(c.tipo||c.motorista||c.nf));
  const alertBox=document.getElementById('form-alert');
  const btn=document.getElementById('btn-submit-main');
  const camPronto = !!(c.tipo && c.horainicial);
  if(alertBox) alertBox.classList.toggle('show', !camPronto);
  if(btn) btn.disabled = !camPronto;
}

function preencherDaTorre(){
  const val=document.getElementById('select_torre').value;
  camSelecionado=null;
  if(!val){ atualizarPreviewAuto(); return; }
  const [origem,chave]=val.split('::');
  let cam=null;
  if(origem==='concluido') cam=torreData.concluidosRecentes[chave];
  if(origem==='doca'||origem==='aguardando'||origem==='concluido'){ reservarCaminhao(val); const info=document.getElementById('reserva-info'); if(info) info.classList.add('show'); }
  if(cam){
    const dados={
      tipo: cam.tipo==='carregamento'?'Carga':'Descarga',
      motorista: cam.motorista||'',
      nf: cam.romaneio||'',
      cliente: cam.destino||cam.transportadora||'',
      baia: origem==='doca'?chave:(cam.doca||''),
      data:'', horainicial:'', horafinal:''
    };
    if(cam.desde){
      const dI=new Date(cam.desde);
      dados.data=dI.toISOString().split('T')[0];
      dados.horainicial=dI.toTimeString().substring(0,5);
    }
    if(origem==='concluido'&&cam.concluidoEm){
      const dF=new Date(cam.concluidoEm);
      dados.horafinal=dF.toTimeString().substring(0,5);
      if(!cam.desde) dados.data=dF.toISOString().split('T')[0];
    }
    camSelecionado=dados;

    // grava nos campos ocultos/reais que vão para a planilha
    if(document.getElementById('field_tipo')) document.getElementById('field_tipo').value=dados.tipo;
    if(document.getElementById('field_motorista')) document.getElementById('field_motorista').value=dados.motorista;
    if(document.getElementById('field_nf')) document.getElementById('field_nf').value=dados.nf;
    if(document.getElementById('field_cliente')) document.getElementById('field_cliente').value=dados.cliente;
    if(document.getElementById('field_data')) document.getElementById('field_data').value=dados.data;
    if(document.getElementById('field_horainicial')) document.getElementById('field_horainicial').value=dados.horainicial;
    if(document.getElementById('field_horafinal')) document.getElementById('field_horafinal').value=dados.horafinal;
    // sugere a posição/baia (usuário ainda pode ajustar, é um dos 4 campos manuais)
    if(document.getElementById('field_baia')&&!document.getElementById('field_baia').value) document.getElementById('field_baia').value=dados.baia;
    // sugere romaneio a partir do que vier da torre, se o campo estiver vazio
    if(document.getElementById('field_romaneio')&&!document.getElementById('field_romaneio').value&&cam.romaneio) document.getElementById('field_romaneio').value=cam.romaneio;
  }
  atualizarPreviewAuto();
}
function setNow(id){ document.getElementById(id).value=new Date().toTimeString().split(' ')[0].substring(0,5); }

// ── SUBMIT ───────────────────────────────────────────────
async function submitForm(){
  if(currentAba==='CargaDescarga'){
    if(!camSelecionado||!camSelecionado.tipo||!camSelecionado.horainicial){
      alert('Selecione um caminhão finalizado na Torre de Controle antes de enviar.');
      return;
    }
    const camposObrig=['baia','conferente','operador','romaneio'];
    for(const id of camposObrig){
      const el=document.getElementById('field_'+id);
      if(!el||!el.value){
        alert('Preencha o campo obrigatório: '+id.toUpperCase());
        if(el) el.focus();
        return;
      }
    }
  }

  const overlay=document.getElementById('loading-overlay');
  overlay.style.display='flex';
  const dados={_aba:currentAba};
  const idsEnvio = currentAba==='CargaDescarga'
    ? [...(SCHEMAS[currentAba]||[]).map(c=>c.id), ...CAMPOS_AUTO_CARGA]
    : (SCHEMAS[currentAba]||[]).map(c=>c.id);
  idsEnvio.forEach(id=>{ const el=document.getElementById('field_'+id); dados[id]=el?el.value:''; });
  if(document.getElementById('field_data')){
    dados.data=document.getElementById('field_data').value;
    dados.horainicial=document.getElementById('field_horainicial').value;
    dados.horafinal=document.getElementById('field_horafinal').value;
  }
  const st=document.getElementById('select_torre');
  const chaveEnv=st?st.value:null;
  try{
    await fetch(WEB_APP_URL,{method:'POST',mode:'no-cors',body:JSON.stringify(dados)});
    if(chaveEnv&&reservasLocais[chaveEnv]){ delete reservasLocais[chaveEnv]; salvarReservasLocais(); }
    alert('Enviado com sucesso!');
    carregarDadosIniciais();
  }catch(e){ alert('Erro ao enviar.'); }
  finally{ overlay.style.display='none'; }
}

// ── HISTORY TABLE ─────────────────────────────────────────
function updateHistoryTable(aba){
  const head=document.getElementById('table-head');
  const body=document.getElementById('table-body');
  head.innerHTML=body.innerHTML='';
  const dados=masterData[aba]||[];
  if(!dados.length) return;
  Object.keys(dados[0]).forEach(k=>{ const th=document.createElement('th'); th.textContent=k.toUpperCase(); head.appendChild(th); });
  dados.slice().reverse().slice(0,10).forEach(row=>{
    const tr=body.insertRow();
    Object.values(row).forEach(v=>{ tr.insertCell().textContent=v; });
  });
}
