// ── RESERVAS ─────────────────────────────────────────────
function carregarReservasLocais(){
  try{ reservasLocais=JSON.parse(localStorage.getItem('icc_reservas')||'{}'); }catch(e){ reservasLocais={}; }
  limparReservasExpiradas();
}
function salvarReservasLocais(){ try{ localStorage.setItem('icc_reservas',JSON.stringify(reservasLocais)); }catch(e){} }
function limparReservasExpiradas(){
  const agora=Date.now();
  Object.keys(reservasLocais).forEach(k=>{ if(agora-reservasLocais[k]>RESERVA_MIN*60000) delete reservasLocais[k]; });
}
function reservarCaminhao(chave){
  if(!chave) return;
  reservasLocais[chave]=Date.now();
  salvarReservasLocais();
  fetch(WEB_APP_URL,{method:'POST',mode:'no-cors',body:JSON.stringify({_aba:'Reservas',chave,sessionId,timestamp:new Date().toISOString()})}).catch(()=>{});
}
function chaveReservadaPorOutro(chave){
  const lista=(masterData&&masterData.Reservas)||[];
  const agora=Date.now();
  return lista.some(r=>{
    const t=new Date(r.timestamp).getTime();
    const exp=isNaN(t)||(agora-t)>RESERVA_MIN*60000;
    return r.chave===chave&&r.sessionId!==sessionId&&!exp;
  });
}

// ── HELPERS ──────────────────────────────────────────────
function hashStr(str){
  let h=5381;
  for(let i=0;i<str.length;i++){ h=((h<<5)+h)+str.charCodeAt(i); h=h&h; }
  return (h>>>0).toString(36);
}
function normKey(v){
  return String(v||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[\s_\-./]/g,'');
}
function getVal(r,keys){
  if(!r) return '';
  const list=Array.isArray(keys)?keys:[keys];
  const map={};
  Object.keys(r).forEach(k=>{ map[normKey(k)]=r[k]; });
  for(const k of list){
    const nk=normKey(k);
    const found=map[nk]!==undefined?map[nk]:r[k];
    if(found!==undefined&&found!==null&&String(found).trim()!=='') return String(found).trim();
  }
  return '';
}

const ABA_NOME={carga:'CargaDescarga',separacao:'Separacao',separacaoOp:'SeparacaoOP',recebimentoOp:'RecebimentoOP'};

function gerarIdAprov(proc, r){
  const aba=ABA_NOME[proc]||proc;
  const chave=[
    aba,
    getVal(r,['data'])||'',
    getVal(r,['conferente'])||'',
    getVal(r,['operador'])||'',
    getVal(r,['horainicial','hora_inicial','hora inicial'])||'',
    getVal(r,['romaneio'])||getVal(r,['nf'])||getVal(r,['baia'])||getVal(r,['quantidade'])||''
  ].join('|');
  return hashStr(chave);
}

function normalizeTipo(t,proc){
  const lo=String(t||proc||'').toLowerCase();
  if(lo.includes('separa')){ return lo.includes('op')?'SEPARAÇÃO OP':'SEPARAÇÃO'; }
  if(lo.includes('receb')) return 'RECEBIMENTO OP';
  if(lo.includes('descarga')) return 'DESCARGA';
  if(lo.includes('carga')) return 'CARREGAMENTO';
  return (t||proc||'').toUpperCase();
}

function parseMin(data,hi,hf){
  if(!data||!hi||!hf) return null;
  const dI=new Date(data+'T'+hi), dF=new Date(data+'T'+hf);
  let d=(dF-dI)/60000;
  if(isNaN(d)) return null;
  if(d<0) d+=1440;
  return(d>=0&&d<1440)?d:null;
}

function getTodayStr(){ return new Date().toISOString().split('T')[0]; }

// ── LOAD DATA ────────────────────────────────────────────
let diagInfo = { ok:false, msg:'Ainda não carregou.', abas:[] };

async function carregarDadosIniciais(){
  let prErr=null;
  const pr = await fetch(WEB_APP_URL+'?t='+Date.now()).then(r=>r.json()).catch(e=>{ prErr=e; return null; });
  const tr = await fetch(TORRE_URL+'?api=1&t='+Date.now()).then(r=>r.json()).catch(()=>null);

  if(pr) masterData=pr;
  if(tr) torreData=tr;
  salvarCacheLocal();

  if(prErr){
    diagInfo = { ok:false, msg:'❌ Erro ao buscar a planilha (WEB_APP_URL): '+prErr.message+'. Provável causa: link não implantado como "Qualquer pessoa" ou arquivo aberto localmente (file://) sem servidor.', abas:[] };
  } else if(!pr || typeof pr!=='object'){
    diagInfo = { ok:false, msg:'⚠️ A planilha respondeu, mas sem dados utilizáveis (resposta vazia ou em formato inesperado).', abas:[] };
  } else {
    const abas = Object.keys(pr);
    const temAprovacoes = abas.some(a=>normKey(a).indexOf('aprovacao')!==-1);
    diagInfo = {
      ok:true,
      msg: temAprovacoes ? '✅ Conectado. Aba de Aprovações encontrada.' : '⚠️ Conectado, mas NÃO existe nenhuma aba chamada "Aprovacoes" na planilha — aprovar/reprovar não vai persistir entre atualizações.',
      abas
    };
  }

  renderForm(currentAba);
  updateHistoryTable(currentAba);
  aprovRefreshData();
  if(currentAba==='Aprovacoes') aprovRenderHoje();
}

async function atualizarTorreSilencioso(){
  try{
    const [pr,tr]=await Promise.all([
      fetch(WEB_APP_URL+'?t='+Date.now()).then(r=>r.json()).catch(()=>null),
      fetch(TORRE_URL+'?api=1&t='+Date.now()).then(r=>r.json()).catch(()=>null)
    ]);
    if(pr) masterData=pr;
    if(tr) torreData=tr;
    salvarCacheLocal();
    if(currentAba==='CargaDescarga'&&document.getElementById('select_torre')) montarSelectTorre();
    aprovRefreshData();
  }catch(e){}
}

// ── APROVAÇÕES — DATA ────────────────────────────────────
function aprovRefreshData(){
  aprovRecords=[];
  aprovMap={};

  const procMap={CargaDescarga:'carga',Separacao:'separacao',SeparacaoOP:'separacaoOp',RecebimentoOP:'recebimentoOp'};
  Object.keys(masterData||{}).forEach(aba=>{
    const an=normKey(aba);
    if(an.indexOf('cadastro')!==-1||an.indexOf('aprovacao')!==-1||an.indexOf('reserva')!==-1) return;
    const linhas=masterData[aba]||[];
    const proc=procMap[aba]||an;
    if(Array.isArray(linhas)){
      linhas.forEach(row=>{
        const tipo=normalizeTipo(getVal(row,['tipo','type']),proc);
        const rec={
          id:gerarIdAprov(proc,row), proc, tipo,
          data:       getVal(row,['data','Data']),
          conferente: getVal(row,['conferente','Conferente']),
          operador:   getVal(row,['operador','Operador']),
          motorista:  getVal(row,['motorista']),
          nf:         getVal(row,['nf','NF']),
          romaneio:   getVal(row,['romaneio']),
          cliente:    getVal(row,['cliente','empresa']),
          baia:       getVal(row,['baia']),
          quantidade: getVal(row,['quantidade']),
          horainicial:getVal(row,['horainicial','hora_inicial','hora inicial','Hora Inicial']),
          horafinal:  getVal(row,['horafinal','hora_final','hora final','Hora Final']),
          status:'PENDENTE'
        };
        if(rec.conferente||rec.operador||rec.horainicial) aprovRecords.push(rec);
      });
    }
  });

  if(masterData.Aprovacoes&&Array.isArray(masterData.Aprovacoes)){
    masterData.Aprovacoes.forEach(r=>{
      const id=getVal(r,['id','ID']);
      const st=getVal(r,['status','Status']);
      if(id&&st) aprovMap[id]=st.toUpperCase();
    });
  }

  aprovRecords=aprovRecords.map(r=>({...r, status:aprovMap[r.id]||'PENDENTE'}));

  // update conferente selects
  const confs=[...new Set(aprovRecords.map(r=>r.conferente).filter(Boolean))].sort();
  ['af-conf','af-hist-conf','af-rel-conf'].forEach(sid=>{
    const sel=document.getElementById(sid); if(!sel) return;
    const cur=sel.value;
    sel.innerHTML='<option value="">Todos</option>'+confs.map(c=>`<option value="${c}">${c}</option>`).join('');
    if(cur) sel.value=cur;
  });

  if(currentAba==='Aprovacoes'){
    aprovRenderHoje();
    setAprovMsg('aprov-status-hoje','✅ Atualizado em '+new Date().toLocaleTimeString('pt-BR'),true);
  }
}

