});

function aprovRenderHoje(){
  const recs=aprovGetHoje();
  const pend=recs.filter(r=>r.status==='PENDENTE').length;
  const aprov=recs.filter(r=>r.status==='APROVADO').length;
  const repro=recs.filter(r=>r.status==='REPROVADO').length;

  document.getElementById('aprov-kpi-hoje').innerHTML=`
    <div class="aprov-kpi blue"><div class="aprov-kpi-val">${recs.length}</div><div class="aprov-kpi-lbl">Total Hoje</div></div>
    <div class="aprov-kpi gold"><div class="aprov-kpi-val">${pend}</div><div class="aprov-kpi-lbl">Pendentes</div></div>
    <div class="aprov-kpi green"><div class="aprov-kpi-val">${aprov}</div><div class="aprov-kpi-lbl">Aprovados</div></div>
    <div class="aprov-kpi red"><div class="aprov-kpi-val">${repro}</div><div class="aprov-kpi-lbl">Reprovados</div></div>
  `;

  // ── PAINEL DE DIAGNÓSTICO (ajuda a identificar por que os dados não aparecem) ──
  const diagCor = diagInfo.ok ? (diagInfo.msg.startsWith('✅')?'var(--primary-green)':'var(--text-gold)') : 'var(--primary-red)';
  const diagHtml = `
    <div style="background:var(--bg-panel);border:1px solid ${diagCor};border-radius:6px;padding:10px 14px;margin-bottom:14px;font-size:11px;color:var(--text-dim);line-height:1.6">
      <div style="color:${diagCor};font-weight:700;margin-bottom:4px">🔧 DIAGNÓSTICO DE CONEXÃO</div>
      <div>${diagInfo.msg}</div>
      <div>Abas encontradas na planilha: ${diagInfo.abas.length ? diagInfo.abas.join(', ') : '(nenhuma)'}</div>
      <div>Total de registros carregados (todas as datas/status): ${aprovRecords.length}</div>
      <div>Registros de hoje (${getTodayStr()}) antes dos filtros: ${aprovRecords.filter(r=>r.data===getTodayStr()).length}</div>
