function statusAprovacaoDoRegistro(r){
  const id=gerarIdAprov('carga',r);
  return aprovMap[id]||'PENDENTE';
}

function renderKPIs(form){
  const todos=(masterData&&masterData.CargaDescarga)||[];
  if(!todos.length){
    const av=document.createElement('div');
    av.className='kpi-aviso';
    av.textContent='⚠️ Ainda não há registros de Carga/Descarga.';
    form.appendChild(av);
    return;
  }

  const classif=todos.map(r=>({r,status:statusAprovacaoDoRegistro(r)}));
  const pend=classif.filter(c=>c.status==='PENDENTE').length;
  const repro=classif.filter(c=>c.status==='REPROVADO').length;
  const registros=classif.filter(c=>c.status==='APROVADO').map(c=>c.r);

  const nota=document.createElement('div'); nota.className='kpi-note';
  nota.textContent='✅ Indicadores consideram SOMENTE operações já aprovadas. Pendentes e reprovadas ficam de fora.';
  form.appendChild(nota);

  const gv=(obj,key)=>{ if(obj[key]!==undefined) return obj[key]; const f=Object.keys(obj).find(k=>k.toLowerCase()===key.toLowerCase()); return f?obj[f]:undefined; };

  const porConf={};
  let tDesc=0,tCarga=0,somaMin=0,comTempo=0;
  registros.forEach(r=>{
    const conf=(gv(r,'conferente')&&String(gv(r,'conferente')).trim())||'Sem Conferente';
    const tipo=String(gv(r,'tipo')||'').toLowerCase();
    if(!porConf[conf]) porConf[conf]={desc:0,carga:0,somaMin:0,comTempo:0};
    if(tipo.includes('descarga')){ porConf[conf].desc++; tDesc++; }
    else if(tipo.includes('carga')){ porConf[conf].carga++; tCarga++; }
    const data=gv(r,'data'),hi=gv(r,'horainicial'),hf=gv(r,'horafinal');
    if(data&&hi&&hf){
      const dI=new Date(data+'T'+hi),dF=new Date(data+'T'+hf);
      let d=(dF-dI)/60000;
      if(!isNaN(d)){ if(d<0)d+=1440; if(d>=0&&d<1440){ porConf[conf].somaMin+=d; porConf[conf].comTempo++; somaMin+=d; comTempo++; } }
    }
  });

  if(!registros.length){
    const av=document.createElement('div'); av.className='kpi-aviso';
    av.textContent='⚠️ Nenhuma operação APROVADA. Pendentes: '+pend+' | Reprovadas: '+repro+'. Aprove na aba ✅ APROVAÇÕES.';
    form.appendChild(av); return;
  }

  [
    {icon:'✅',label:'Aprovados',value:registros.length},
    {icon:'⏳',label:'Pendentes',value:pend},
    {icon:'❌',label:'Reprovados',value:repro},
    {icon:'⏱',label:'Tempo Médio (min)',value:comTempo?Math.round(somaMin/comTempo):'--'}
  ].forEach(c=>{
